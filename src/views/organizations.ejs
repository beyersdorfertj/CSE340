<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <p>Here are a few of our partner organizations:</p>
        <ul>
            <% organizations.forEach(organization => { %>
            <li><img src="/images/<%= organization.logoFilename %>" alt="<%= organization.name %> logo"><a href="/organization/<%= organization.organizationId %>"><%= organization.name %></a>: <%= organization.contactEmail %></li>
            <% }); %>
        </ul>
        <p><a href="/organization/new">Add a new organization</a></p>
    </main>
<%- include('partials/footer') %>